  "captions": [
    {
      "start": 0.0,
      "end": 3.3449477351916377,
      "text": "НАБУ і САП заявили про\nвикриття нової організації:",
      "kind": "author"
    },
    {
      "start": 3.3449477351916377,
      "end": 6.0,
      "text": "колцентри, наркотики та\nймовірне прикриття силовиків.",
      "kind": "author"
    },
    {
      "start": 6,
      "end": 9.8,
      "text": "НАБУ та САП викрили\nзлочинну організацію,",
      "kind": "original"
    },
    {
      "start": 9.8,
      "end": 12.9,
      "text": "що спеціалізувалась на шахрайстві,",
      "kind": "original"
    },
    {
      "start": 12.9,
      "end": 14.8,
      "text": "так званих колцентрах",
      "kind": "original"
    },
    {
      "start": 14.8,
      "end": 17.9,
      "text": "і розповсюдженні\nнаркотичних засобів.",
      "kind": "original"
    },
    {
      "start": 17.9,
      "end": 21.388372093023253,
      "text": "У повідомленні йдеться\nщонайменше про дванадцять",
      "kind": "author"
    },
    {
      "start": 21.388372093023253,
      "end": 22.17325581395349,
      "text": "учасників.",
      "kind": "author"
    },
    {
      "start": 22.17325581395349,
      "end": 26.446511627906975,
      "text": "Серед ключових псевдонімів —\n«Кримінал» і «Мексиканець».",
      "kind": "author"
    },
    {
      "start": 26.446511627906975,
      "end": 30.516279069767442,
      "text": "«Прайс» та «Консультант», за\nверсією слідства, представляли",
      "kind": "author"
    },
    {
      "start": 30.516279069767442,
      "end": 33.0453488372093,
      "text": "поліцію, «Акім» — СБУ.",
      "kind": "author"
    },
    {
      "start": 33.0453488372093,
      "end": 35.37093023255814,
      "text": "Детективи описують\nсистему щомісячних",
      "kind": "author"
    },
    {
      "start": 35.37093023255814,
      "end": 37.9,
      "text": "платежів за прикриття бізнесу.",
      "kind": "author"
    },
    {
      "start": 37.9,
      "end": 40.65,
      "text": "Стандартна сума\nстановила 7 тисяч доларів",
      "kind": "original"
    },
    {
      "start": 40.65,
      "end": 42.699999999999996,
      "text": "в місяць з одного колцентру.",
      "kind": "original"
    },
    {
      "start": 42.699999999999996,
      "end": 45.6,
      "text": "На початку місяця\nпередавав адреси",
      "kind": "original"
    },
    {
      "start": 45.6,
      "end": 48.3,
      "text": "колцентрів з їхніми\nідентифікаторами,",
      "kind": "original"
    },
    {
      "start": 48.3,
      "end": 51.599999999999994,
      "text": "а до п’ятого числа\nсплачував зазначену суму",
      "kind": "original"
    },
    {
      "start": 51.599999999999994,
      "end": 52.4,
      "text": "в криптовалюті",
      "kind": "original"
    },
    {
      "start": 52.4,
      "end": 55.8,
      "text": "на заздалегідь наданий\nправоохоронцями гаманець.",
      "kind": "original"
    },
    {
      "start": 55.8,
      "end": 59.25679012345679,
      "text": "У матеріалах показано листування\nпро офіси, криптогаманці та",
      "kind": "author"
    },
    {
      "start": 59.25679012345679,
      "end": 60.27222222222222,
      "text": "вилучену техніку.",
      "kind": "author"
    },
    {
      "start": 60.27222222222222,
      "end": 63.880246913580244,
      "text": "За версією слідства, її\nнамагалися повернути через суд.",
      "kind": "author"
    },
    {
      "start": 63.880246913580244,
      "end": 67.48827160493826,
      "text": "Кошти з окремого платежу не\nдорівнюють загальним збиткам.",
      "kind": "author"
    },
    {
      "start": 67.48827160493826,
      "end": 69.8,
      "text": "Масштаб мережі НАБУ описує так.",
      "kind": "author"
    },
    {
      "start": 69.8,
      "end": 71.8,
      "text": "Як з’ясувало слідство,",
      "kind": "original"
    },
    {
      "start": 71.8,
      "end": 74.1,
      "text": "учасники злочинної організації",
      "kind": "original"
    },
    {
      "start": 74.1,
      "end": 77.3,
      "text": "координували діяльність\nщонайменше 52 колцентрів.",
      "kind": "original"
    },
    {
      "start": 77.3,
      "end": 81.39999999999999,
      "text": "В цих офісах працювало\nщонайменше 2700 людей,",
      "kind": "original"
    },
    {
      "start": 81.39999999999999,
      "end": 84.89999999999999,
      "text": "які щодня ошукували громадян\nУкраїни та інших країн.",
      "kind": "original"
    },
    {
      "start": 84.9,
      "end": 89.22883435582823,
      "text": "Окремий напрям, за даними\nНАБУ, — наркобізнес.",
      "kind": "author"
    },
    {
      "start": 89.22883435582823,
      "end": 91.79079754601227,
      "text": "«Мексиканця» пов’язують\nіз «Хімпромом».",
      "kind": "author"
    },
    {
      "start": 91.79079754601227,
      "end": 96.50245398773006,
      "text": "У фільмі згадуються магазини\nU420 та розмови про",
      "kind": "author"
    },
    {
      "start": 96.50245398773006,
      "end": 99.06441717791411,
      "text": "можливий вплив на законодавство.",
      "kind": "author"
    },
    {
      "start": 99.06441717791411,
      "end": 103.7760736196319,
      "text": "Згадка посадовця в чужій\nрозмові не доводить його",
      "kind": "author"
    },
    {
      "start": 103.7760736196319,
      "end": 104.57116564417178,
      "text": "участі.",
      "kind": "author"
    },
    {
      "start": 104.57116564417178,
      "end": 108.9,
      "text": "Чим завершився описаний план,\nпояснюють автори фільму.",
      "kind": "author"
    },
    {
      "start": 108.9,
      "end": 111.60000000000001,
      "text": "Отже, учасники\nзлочинної організації",
      "kind": "original"
    },
    {
      "start": 111.60000000000001,
      "end": 114.10000000000001,
      "text": "були готові підкуповувати\nне лише міністрів,",
      "kind": "original"
    },
    {
      "start": 114.10000000000001,
      "end": 116.0,
      "text": "а й інших впливових осіб,",
      "kind": "original"
    },
    {
      "start": 116.0,
      "end": 118.7,
      "text": "здатних вирішити питання\nна державному рівні.",
      "kind": "original"
    },
    {
      "start": 118.7,
      "end": 122.10000000000001,
      "text": "План підкупу так і не\nвдалося реалізувати,",
      "kind": "original"
    },
    {
      "start": 122.10000000000001,
      "end": 125.0,
      "text": "зокрема на тлі журналістського\nрозслідування Bihus.Info,",
      "kind": "original"
    },
    {
      "start": 125.0,
      "end": 127.5,
      "text": "про підготовку якого\nстало відомо фігурантам.",
      "kind": "original"
    },
    {
      "start": 127.5,
      "end": 131.68952618453866,
      "text": "Фігуранти, за даними НАБУ,\nобговорювали тиск на журналістів",
      "kind": "author"
    },
    {
      "start": 131.68952618453866,
      "end": 132.57980049875312,
      "text": "Bihus.Info.",
      "kind": "author"
    },
    {
      "start": 132.57980049875312,
      "end": 136.76932668329178,
      "text": "Окремо бюро показало кадри\nнападу біля спортклубу в",
      "kind": "author"
    },
    {
      "start": 136.76932668329178,
      "end": 137.47630922693267,
      "text": "Києві.",
      "kind": "author"
    },
    {
      "start": 137.47630922693267,
      "end": 140.61845386533665,
      "text": "Серед імовірних виконавців\nнасильницьких злочинів називають",
      "kind": "author"
    },
    {
      "start": 140.61845386533665,
      "end": 142.37281795511223,
      "text": "«Боксера» та «Пашу».",
      "kind": "author"
    },
    {
      "start": 142.37281795511223,
      "end": 145.69825436408976,
      "text": "Ще один напрям — підроблені євро.",
      "kind": "author"
    },
    {
      "start": 145.69825436408976,
      "end": 148.5,
      "text": "Як НАБУ пояснює\nприкриття виконавців?",
      "kind": "author"
    },
    {
      "start": 148.5,
      "end": 151.0,
      "text": "Відчуття безкарності забезпечував",
      "kind": "original"
    },
    {
      "start": 151.0,
      "end": 153.1,
      "text": "постійний витік\nслужбової інформації.",
      "kind": "original"
    },
    {
      "start": 153.1,
      "end": 155.4,
      "text": "Щойно потерпілий\nзвертався до поліції,",
      "kind": "original"
    },
    {
      "start": 155.4,
      "end": 157.8,
      "text": "замовники вже знали,\nхто розслідує справу,",
      "kind": "original"
    },
    {
      "start": 157.8,
      "end": 161.0,
      "text": "і запевняли спільників, що\nситуація під контролем.",
      "kind": "original"
    },
    {
      "start": 161.0,
      "end": 164.39648798521256,
      "text": "Окремо бюро розповідає про\nнадходження на криптогаманець.",
      "kind": "author"
    },
    {
      "start": 164.39648798521256,
      "end": 168.09334565619224,
      "text": "Це сума за визначений\nперіод — її не",
      "kind": "author"
    },
    {
      "start": 168.09334565619224,
      "end": 171.32809611829944,
      "text": "можна вважати місячним\nприбутком чи розміром усіх",
      "kind": "author"
    },
    {
      "start": 171.32809611829944,
      "end": 173.5,
      "text": "збитків. Ось дані НАБУ.",
      "kind": "author"
    },
    {
      "start": 173.5,
      "end": 175.9,
      "text": "Слідством встановлено,\nщо за період",
      "kind": "original"
    },
    {
      "start": 175.9,
      "end": 178.5,
      "text": "з 16 жовтня 2025 року",
      "kind": "original"
    },
    {
      "start": 178.5,
      "end": 181.9,
      "text": "по 25 квітня 2026 року",
      "kind": "original"
    },
    {
      "start": 181.9,
      "end": 184.4,
      "text": "на вказаний\nкриптогаманець надійшло",
      "kind": "original"
    },
    {
      "start": 184.4,
      "end": 187.9,
      "text": "3 мільйони 750 тисяч USDT.",
      "kind": "original"
    },
    {
      "start": 187.9,
      "end": 192.74057971014494,
      "text": "СБУ, своєю чергою, повідомила про\nзвільнення двох високопосадовців.",
      "kind": "author"
    },
    {
      "start": 192.74057971014494,
      "end": 197.37826086956522,
      "text": "Керівник служби Олександр\nПоклад заявив про співпрацю з",
      "kind": "author"
    },
    {
      "start": 197.37826086956522,
      "end": 201.63913043478263,
      "text": "НАБУ і САП та очікування\nоб’єктивного розслідування.",
      "kind": "author"
    },
    {
      "start": 201.63913043478263,
      "end": 205.32028985507247,
      "text": "Кадрове рішення не\nє визнанням вини.",
      "kind": "author"
    },
    {
      "start": 205.32028985507247,
      "end": 209.37826086956522,
      "text": "Водночас у фільмі НАБУ\nставлять питання до",
      "kind": "author"
    },
    {
      "start": 209.37826086956522,
      "end": 211.9,
      "text": "роботи інших\nправоохоронних органів.",
      "kind": "author"
    },
    {
      "start": 211.9,
      "end": 214.6,
      "text": "Втім, злочинна діяльність\nтривала роками.",
      "kind": "original"
    },
    {
      "start": 214.6,
      "end": 217.70000000000002,
      "text": "Чому її не зупиняли раніше\n— питання відкрите.",
      "kind": "original"
    },
    {
      "start": 217.7,
      "end": 219.70264150943396,
      "text": "Це опублікована версія слідства.",
      "kind": "author"
    },
    {
      "start": 219.70264150943396,
      "end": 222.16566037735848,
      "text": "Звільнення посадовців\nне є вироком.",
      "kind": "author"
    },
    {
      "start": 222.16566037735848,
      "end": 225.84867924528302,
      "text": "Які докази будуть визнані\nдопустимими й чия вина",
      "kind": "author"
    },
    {
      "start": 225.84867924528302,
      "end": 228.31169811320754,
      "text": "буде доведена, має визначити суд.",
      "kind": "author"
    },
    {
      "start": 228.31169811320754,
      "end": 231.99471698113206,
      "text": "Окремих перевірених відповідей\nусіх названих фігурантів у зібраних",
      "kind": "author"
    },
    {
      "start": 231.99471698113206,
      "end": 233.0766037735849,
      "text": "матеріалах немає.",
      "kind": "author"
    },
    {
      "start": 233.0766037735849,
      "end": 236.0,
      "text": "Версія слідства — ще не вирок.",
      "kind": "author"
    }
  ]
}