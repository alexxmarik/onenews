Dialogue: 1,0:00:06.00,0:00:09.80,Sub,,0,0,0,,{}НАБУ та САП викрили\Nзлочинну організацію,
Dialogue: 1,0:00:09.80,0:00:12.90,Sub,,0,0,0,,{}що спеціалізувалась на шахрайстві,
Dialogue: 1,0:00:12.90,0:00:14.80,Sub,,0,0,0,,{}так званих колцентрах
Dialogue: 1,0:00:14.80,0:00:17.90,Sub,,0,0,0,,{}і розповсюдженні\Nнаркотичних засобів.
Dialogue: 1,0:00:37.90,0:00:40.65,Sub,,0,0,0,,{}Стандартна сума\Nстановила 7 тисяч доларів
Dialogue: 1,0:00:40.65,0:00:42.70,Sub,,0,0,0,,{}в місяць з одного колцентру.
Dialogue: 1,0:00:42.70,0:00:45.60,Sub,,0,0,0,,{}На початку місяця\Nпередавав адреси
Dialogue: 1,0:00:45.60,0:00:48.30,Sub,,0,0,0,,{}колцентрів з їхніми\Nідентифікаторами,
Dialogue: 1,0:00:48.30,0:00:51.60,Sub,,0,0,0,,{}а до п’ятого числа\Nсплачував зазначену суму
Dialogue: 1,0:00:51.60,0:00:52.40,Sub,,0,0,0,,{}в криптовалюті
Dialogue: 1,0:00:52.40,0:00:55.80,Sub,,0,0,0,,{}на заздалегідь наданий\Nправоохоронцями гаманець.
Dialogue: 1,0:01:09.80,0:01:11.80,Sub,,0,0,0,,{}Як з’ясувало слідство,
Dialogue: 1,0:01:11.80,0:01:14.10,Sub,,0,0,0,,{}учасники злочинної організації
Dialogue: 1,0:01:14.10,0:01:17.30,Sub,,0,0,0,,{}координували діяльність\Nщонайменше 52 колцентрів.
Dialogue: 1,0:01:17.30,0:01:21.40,Sub,,0,0,0,,{}В цих офісах працювало\Nщонайменше 2700 людей,
Dialogue: 1,0:01:21.40,0:01:24.90,Sub,,0,0,0,,{}які щодня ошукували громадян\NУкраїни та інших країн.
Dialogue: 1,0:01:48.90,0:01:51.60,Sub,,0,0,0,,{}Отже, учасники\Nзлочинної організації
Dialogue: 1,0:01:51.60,0:01:54.10,Sub,,0,0,0,,{}були готові підкуповувати\Nне лише міністрів,
Dialogue: 1,0:01:54.10,0:01:56.00,Sub,,0,0,0,,{}а й інших впливових осіб,
Dialogue: 1,0:01:56.00,0:01:58.70,Sub,,0,0,0,,{}здатних вирішити питання\Nна державному рівні.
Dialogue: 1,0:01:58.70,0:02:02.10,Sub,,0,0,0,,{}План підкупу так і не\Nвдалося реалізувати,
Dialogue: 1,0:02:02.10,0:02:05.00,Sub,,0,0,0,,{}зокрема на тлі журналістського\Nрозслідування Bihus.Info,
Dialogue: 1,0:02:05.00,0:02:07.50,Sub,,0,0,0,,{}про підготовку якого\Nстало відомо фігурантам.
Dialogue: 1,0:02:28.50,0:02:31.00,Sub,,0,0,0,,{}Відчуття безкарності забезпечував
Dialogue: 1,0:02:31.00,0:02:33.10,Sub,,0,0,0,,{}постійний витік\Nслужбової інформації.
Dialogue: 1,0:02:33.10,0:02:35.40,Sub,,0,0,0,,{}Щойно потерпілий\Nзвертався до поліції,
Dialogue: 1,0:02:35.40,0:02:37.80,Sub,,0,0,0,,{}замовники вже знали,\Nхто розслідує справу,
Dialogue: 1,0:02:37.80,0:02:41.00,Sub,,0,0,0,,{}і запевняли спільників, що\Nситуація під контролем.
Dialogue: 1,0:02:53.50,0:02:55.90,Sub,,0,0,0,,{}Слідством встановлено,\Nщо за період
Dialogue: 1,0:02:55.90,0:02:58.50,Sub,,0,0,0,,{}з 16 жовтня 2025 року
Dialogue: 1,0:02:58.50,0:03:01.90,Sub,,0,0,0,,{}по 25 квітня 2026 року
Dialogue: 1,0:03:01.90,0:03:04.40,Sub,,0,0,0,,{}на вказаний\Nкриптогаманець надійшло
Dialogue: 1,0:03:04.40,0:03:07.90,Sub,,0,0,0,,{}3 мільйони 750 тисяч USDT.
Dialogue: 1,0:03:31.90,0:03:34.60,Sub,,0,0,0,,{}Втім, злочинна діяльність\Nтривала роками.
Dialogue: 1,0:03:34.60,0:03:37.70,Sub,,0,0,0,,{}Чому її не зупиняли раніше\N— питання відкрите.
Dialogue: 1,0:00:00.00,0:00:03.34,Sub,,0,0,0,,{}НАБУ і САП заявили про\Nвикриття нової організації:
Dialogue: 1,0:00:03.34,0:00:06.00,Sub,,0,0,0,,{}колцентри, наркотики та\Nймовірне прикриття силовиків.
Dialogue: 1,0:00:17.90,0:00:21.39,Sub,,0,0,0,,{}У повідомленні йдеться\Nщонайменше про дванадцять
Dialogue: 1,0:00:21.39,0:00:22.17,Sub,,0,0,0,,{}учасників.
Dialogue: 1,0:00:22.17,0:00:26.45,Sub,,0,0,0,,{}Серед ключових псевдонімів —\N«Кримінал» і «Мексиканець».
Dialogue: 1,0:00:26.45,0:00:30.52,Sub,,0,0,0,,{}«Прайс» та «Консультант», за\Nверсією слідства, представляли
Dialogue: 1,0:00:30.52,0:00:33.05,Sub,,0,0,0,,{}поліцію, «Акім» — СБУ.
Dialogue: 1,0:00:33.05,0:00:35.37,Sub,,0,0,0,,{}Детективи описують\Nсистему щомісячних
Dialogue: 1,0:00:35.37,0:00:37.90,Sub,,0,0,0,,{}платежів за прикриття бізнесу.
Dialogue: 1,0:00:55.80,0:00:59.26,Sub,,0,0,0,,{}У матеріалах показано листування\Nпро офіси, криптогаманці та
Dialogue: 1,0:00:59.26,0:01:00.27,Sub,,0,0,0,,{}вилучену техніку.
Dialogue: 1,0:01:00.27,0:01:03.88,Sub,,0,0,0,,{}За версією слідства, її\Nнамагалися повернути через суд.
Dialogue: 1,0:01:03.88,0:01:07.49,Sub,,0,0,0,,{}Кошти з окремого платежу не\Nдорівнюють загальним збиткам.
Dialogue: 1,0:01:07.49,0:01:09.80,Sub,,0,0,0,,{}Масштаб мережі НАБУ описує так.
Dialogue: 1,0:01:24.90,0:01:29.23,Sub,,0,0,0,,{}Окремий напрям, за даними\NНАБУ, — наркобізнес.
Dialogue: 1,0:01:29.23,0:01:31.79,Sub,,0,0,0,,{}«Мексиканця» пов’язують\Nіз «Хімпромом».
Dialogue: 1,0:01:31.79,0:01:36.50,Sub,,0,0,0,,{}У фільмі згадуються магазини\NU420 та розмови про
Dialogue: 1,0:01:36.50,0:01:39.06,Sub,,0,0,0,,{}можливий вплив на законодавство.
Dialogue: 1,0:01:39.06,0:01:43.78,Sub,,0,0,0,,{}Згадка посадовця в чужій\Nрозмові не доводить його
Dialogue: 1,0:01:43.78,0:01:44.57,Sub,,0,0,0,,{}участі.
Dialogue: 1,0:01:44.57,0:01:48.90,Sub,,0,0,0,,{}Чим завершився описаний план,\Nпояснюють автори фільму.
Dialogue: 1,0:02:07.50,0:02:11.69,Sub,,0,0,0,,{}Фігуранти, за даними НАБУ,\Nобговорювали тиск на журналістів
Dialogue: 1,0:02:11.69,0:02:12.58,Sub,,0,0,0,,{}Bihus.Info.
Dialogue: 1,0:02:12.58,0:02:16.77,Sub,,0,0,0,,{}Окремо бюро показало кадри\Nнападу біля спортклубу в
Dialogue: 1,0:02:16.77,0:02:17.48,Sub,,0,0,0,,{}Києві.
Dialogue: 1,0:02:17.48,0:02:20.62,Sub,,0,0,0,,{}Серед імовірних виконавців\Nнасильницьких злочинів називають
Dialogue: 1,0:02:20.62,0:02:22.37,Sub,,0,0,0,,{}«Боксера» та «Пашу».
Dialogue: 1,0:02:22.37,0:02:25.70,Sub,,0,0,0,,{}Ще один напрям — підроблені євро.
Dialogue: 1,0:02:25.70,0:02:28.50,Sub,,0,0,0,,{}Як НАБУ пояснює\Nприкриття виконавців?
Dialogue: 1,0:02:41.00,0:02:44.40,Sub,,0,0,0,,{}Окремо бюро розповідає про\Nнадходження на криптогаманець.
Dialogue: 1,0:02:44.40,0:02:48.09,Sub,,0,0,0,,{}Це сума за визначений\Nперіод — її не
Dialogue: 1,0:02:48.09,0:02:51.33,Sub,,0,0,0,,{}можна вважати місячним\Nприбутком чи розміром усіх
Dialogue: 1,0:02:51.33,0:02:53.50,Sub,,0,0,0,,{}збитків. Ось дані НАБУ.
Dialogue: 1,0:03:07.90,0:03:12.74,Sub,,0,0,0,,{}СБУ, своєю чергою, повідомила про\Nзвільнення двох високопосадовців.
Dialogue: 1,0:03:12.74,0:03:17.38,Sub,,0,0,0,,{}Керівник служби Олександр\NПоклад заявив про співпрацю з
Dialogue: 1,0:03:17.38,0:03:21.64,Sub,,0,0,0,,{}НАБУ і САП та очікування\Nоб’єктивного розслідування.
Dialogue: 1,0:03:21.64,0:03:25.32,Sub,,0,0,0,,{}Кадрове рішення не\Nє визнанням вини.
Dialogue: 1,0:03:25.32,0:03:29.38,Sub,,0,0,0,,{}Водночас у фільмі НАБУ\Nставлять питання до
Dialogue: 1,0:03:29.38,0:03:31.90,Sub,,0,0,0,,{}роботи інших\Nправоохоронних органів.
Dialogue: 1,0:03:37.70,0:03:39.70,Sub,,0,0,0,,{}Це опублікована версія слідства.
Dialogue: 1,0:03:39.70,0:03:42.17,Sub,,0,0,0,,{}Звільнення посадовців\Nне є вироком.
Dialogue: 1,0:03:42.17,0:03:45.85,Sub,,0,0,0,,{}Які докази будуть визнані\Nдопустимими й чия вина
Dialogue: 1,0:03:45.85,0:03:48.31,Sub,,0,0,0,,{}буде доведена, має визначити суд.
Dialogue: 1,0:03:48.31,0:03:51.99,Sub,,0,0,0,,{}Окремих перевірених відповідей\Nусіх названих фігурантів у зібраних
Dialogue: 1,0:03:51.99,0:03:53.08,Sub,,0,0,0,,{}матеріалах немає.
Dialogue: 1,0:03:53.08,0:03:56.00,Sub,,0,0,0,,{}Версія слідства — ще не вирок.
