Dialogue: 1,0:02:57.90,0:03:10.40,Tag,,0,0,0,,{\pos(78,1405)}ОРИГІНАЛЬНИЙ ЗВУК · НАБУ / САП
Dialogue: 1,0:00:00.00,0:00:04.50,Original,,0,0,0,,{}Це був не поодинокий епізод,\Nа системний бізнес на\Nнасильстві.
Dialogue: 1,0:00:18.00,0:00:22.00,Original,,0,0,0,,{}НАБУ та САП викрили\Nзлочинну організацію,
Dialogue: 1,0:00:22.00,0:00:26.80,Original,,0,0,0,,{}що спеціалізувалась на\Nшахрайстві, так званих\Nколцентрах
Dialogue: 1,0:00:26.80,0:00:29.90,Original,,0,0,0,,{}і розповсюдженні\Nнаркотичних засобів.
Dialogue: 1,0:01:07.00,0:01:11.80,Original,,0,0,0,,{}Стандартна сума становила\N7 тисяч доларів в місяць\Nз одного колцентру.
Dialogue: 1,0:01:11.80,0:01:17.40,Original,,0,0,0,,{}На початку місяця передавав\Nадреси колцентрів з їхніми\Nідентифікаторами,
Dialogue: 1,0:01:17.40,0:01:21.55,Original,,0,0,0,,{}а до п’ятого числа сплачував\Nзазначену суму в\Nкриптовалюті
Dialogue: 1,0:01:21.55,0:01:24.90,Original,,0,0,0,,{}на заздалегідь наданий\Nправоохоронцями гаманець.
Dialogue: 1,0:01:42.00,0:01:44.00,Original,,0,0,0,,{}Як з’ясувало слідство,
Dialogue: 1,0:01:44.00,0:01:46.30,Original,,0,0,0,,{}учасники злочинної\Nорганізації
Dialogue: 1,0:01:46.30,0:01:49.50,Original,,0,0,0,,{}координували діяльність\Nщонайменше 52 колцентрів.
Dialogue: 1,0:01:49.50,0:01:53.60,Original,,0,0,0,,{}В цих офісах працювало\Nщонайменше 2700 людей,
Dialogue: 1,0:01:53.60,0:01:57.10,Original,,0,0,0,,{}які щодня ошукували\Nгромадян України та інших\Nкраїн.
Dialogue: 1,0:02:45.00,0:02:47.80,Original,,0,0,0,,{}Група виконувала подібні\Nзамовлення
Dialogue: 1,0:02:47.80,0:02:50.40,Original,,0,0,0,,{}навіть за кордоном, зокрема\Nу Відні.
Dialogue: 1,0:02:57.90,0:03:02.50,Original,,0,0,0,,{}Відчуття безкарності\Nзабезпечував постійний витік\Nслужбової інформації.
Dialogue: 1,0:03:02.50,0:03:04.80,Original,,0,0,0,,{}Щойно потерпілий звертався\Nдо поліції,
Dialogue: 1,0:03:04.80,0:03:07.20,Original,,0,0,0,,{}замовники вже знали, хто\Nрозслідує справу,
Dialogue: 1,0:03:07.20,0:03:10.40,Original,,0,0,0,,{}і запевняли спільників, що\Nситуація під контролем.
Dialogue: 1,0:00:04.50,0:00:06.93,Author,,0,0,0,,{}Колцентри, наркотики та\Nймовірне прикриття силовиків.
Dialogue: 1,0:00:06.93,0:00:09.74,Author,,0,0,0,,{}НАБУ і САП оприлюднили\Nпродовження операції\N«Карфаген».
Dialogue: 1,0:00:09.74,0:00:13.68,Author,,0,0,0,,{}За версією слідства, до нової\Nорганізації входили\Nщонайменше дванадцять осіб.
Dialogue: 1,0:00:13.68,0:00:15.94,Author,,0,0,0,,{}Що саме їм інкримінують,\Nпояснює керівник
Dialogue: 1,0:00:15.94,0:00:18.00,Author,,0,0,0,,{}підрозділу детективів НАБУ\NОлександр Абакумов.
Dialogue: 1,0:00:29.90,0:00:35.01,Author,,0,0,0,,{}Це новий епізод операції, про\Nяку антикорупційні органи\Nповідомляли у вересні.
Dialogue: 1,0:00:35.01,0:00:40.13,Author,,0,0,0,,{}Двадцять другого жовтня вони\Nоголосили ще одну підозру в\Nпопередньому епізоді.
Dialogue: 1,0:00:40.13,0:00:42.56,Author,,0,0,0,,{}Тепер слідство описує іншу\Nорганізацію.
Dialogue: 1,0:00:42.56,0:00:47.03,Author,,0,0,0,,{}Її керівником називає\N«Кримінала», а одним із\Nключових учасників —
Dialogue: 1,0:00:47.03,0:00:47.68,Author,,0,0,0,,{}«Мексиканця».
Dialogue: 1,0:00:47.68,0:00:53.24,Author,,0,0,0,,{}Українська правда з посиланням\Nна власні джерела пов’язує\N«Кримінала» з Андрієм Осіповим.
Dialogue: 1,0:00:53.24,0:00:54.78,Author,,0,0,0,,{}Це ідентифікація видання.
Dialogue: 1,0:00:54.78,0:00:58.80,Author,,0,0,0,,{}У матеріалах також фігурують\Nполіцейські «Прайс» і\N«Консультант» та
Dialogue: 1,0:00:58.80,0:01:00.34,Author,,0,0,0,,{}високопосадовець СБУ «Акім».
Dialogue: 1,0:01:00.34,0:01:03.92,Author,,0,0,0,,{}За версією детективів, їхні\Nзв’язки забезпечували\Nприкриття незаконної
Dialogue: 1,0:01:03.92,0:01:04.57,Author,,0,0,0,,{}діяльності.
Dialogue: 1,0:01:04.57,0:01:07.00,Author,,0,0,0,,{}Як описують платежі в НАБУ?
Dialogue: 1,0:01:24.90,0:01:28.67,Author,,0,0,0,,{}Це пояснення слідства, а не\Nрішення суду.
Dialogue: 1,0:01:28.67,0:01:32.44,Author,,0,0,0,,{}Окремий платіж не можна\Nназивати загальними збитками.
Dialogue: 1,0:01:32.44,0:01:38.23,Author,,0,0,0,,{}У фільмі також показано\Nлистування про повернення\Nвилученої техніки через суд.
Dialogue: 1,0:01:38.23,0:01:42.00,Author,,0,0,0,,{}А ось як НАБУ оцінює масштаб\Nмережі.
Dialogue: 1,0:01:57.10,0:01:58.80,Author,,0,0,0,,{}Розслідування не обмежується\Nколцентрами.
Dialogue: 1,0:01:58.80,0:02:02.41,Author,,0,0,0,,{}НАБУ також заявляє про\Nконтакти «Мексиканця» з ФСБ\NРосії.
Dialogue: 1,0:02:02.41,0:02:05.26,Author,,0,0,0,,{}Незалежного підтвердження\Nцих зв’язків у нас немає.
Dialogue: 1,0:02:05.26,0:02:09.46,Author,,0,0,0,,{}За версією НАБУ, «Мексиканець»\Nпов’язаний із «Хімпромом», а\Nфігуранти обговорювали бізнес
Dialogue: 1,0:02:09.46,0:02:13.07,Author,,0,0,0,,{}мережі U420 та можливість\Nвпливати на правила обігу\Nречовин.
Dialogue: 1,0:02:13.07,0:02:17.06,Author,,0,0,0,,{}У фільмі окремо зазначено:\Nописаний план підкупу не\Nвдалося реалізувати.
Dialogue: 1,0:02:17.06,0:02:21.64,Author,,0,0,0,,{}Згадування посадовця в чужій\Nрозмові не доводить, що він брав\Nу цьому
Dialogue: 1,0:02:21.64,0:02:23.34,Author,,0,0,0,,{}участь або отримував гроші.
Dialogue: 1,0:02:23.34,0:02:26.57,Author,,0,0,0,,{}Ще один напрям — можливий\Nтиск на журналістів.
Dialogue: 1,0:02:26.57,0:02:30.94,Author,,0,0,0,,{}Слідство оприлюднило\Nобговорення щодо Дениса Бігуса\Nта інших критиків цієї діяльності.
Dialogue: 1,0:02:30.94,0:02:34.93,Author,,0,0,0,,{}Погрози й обговорення планів не\Nслід автоматично називати\Nздійсненими нападами.
Dialogue: 1,0:02:34.93,0:02:38.93,Author,,0,0,0,,{}Детективи також заявляють про\Nпідроблення євро та ймовірні\Nнасильницькі злочини.
Dialogue: 1,0:02:38.93,0:02:42.15,Author,,0,0,0,,{}Серед імовірних виконавців\Nслідство називає «Боксера» та\N«Пашу».
Dialogue: 1,0:02:42.15,0:02:45.00,Author,,0,0,0,,{}Про дії за кордоном Абакумов\Nговорить так.
Dialogue: 1,0:02:50.40,0:02:52.97,Author,,0,0,0,,{}Що давало змогу уникати\Nвикриття?
Dialogue: 1,0:02:52.97,0:02:57.90,Author,,0,0,0,,{}У фільмі НАБУ пояснюють:\Nйдеться про постійний витік\Nслужбової інформації.
Dialogue: 1,0:03:10.40,0:03:15.78,Author,,0,0,0,,{}НАБУ також заявляє про\Nнадходження трьох мільйонів\Nсемисот п’ятдесяти тисяч USDT
Dialogue: 1,0:03:15.78,0:03:20.41,Author,,0,0,0,,{}на один гаманець із жовтня\N2025-го до квітня 2026-го.
Dialogue: 1,0:03:20.41,0:03:26.50,Author,,0,0,0,,{}Це загальна сума за період, а не\Nмісячний прибуток або всі\Nзбитки.
Dialogue: 1,0:03:26.50,0:03:29.59,Author,,0,0,0,,{}Є й офіційна реакція Служби\Nбезпеки.
Dialogue: 1,0:03:29.59,0:03:34.37,Author,,0,0,0,,{}Четвертого листопада СБУ\Nповідомила про звільнення двох\Nвисокопосадовців, які стали
Dialogue: 1,0:03:34.37,0:03:35.54,Author,,0,0,0,,{}фігурантами розслідування.
Dialogue: 1,0:03:35.54,0:03:40.33,Author,,0,0,0,,{}Очільник служби Олександр\NПоклад заявив про сприяння\Nпроцесуальним діям і
Dialogue: 1,0:03:40.33,0:03:43.41,Author,,0,0,0,,{}необхідність прозорого,\Nоб’єктивного та неупередженого\Nрозслідування.
Dialogue: 1,0:03:43.41,0:03:45.06,Author,,0,0,0,,{}Це позиція відомства.
Dialogue: 1,0:03:45.06,0:03:48.89,Author,,0,0,0,,{}Кадрове рішення саме по собі не\Nє вироком
Dialogue: 1,0:03:48.89,0:03:51.50,Author,,0,0,0,,{}суду або визнанням усіх\Nзвинувачень.
Dialogue: 1,0:03:51.50,0:03:56.17,Author,,0,0,0,,{}Отже, нині маємо оприлюднені\Nматеріали НАБУ і САП,\Nжурналістські повідомлення та
Dialogue: 1,0:03:56.17,0:03:57.21,Author,,0,0,0,,{}реакцію СБУ.
Dialogue: 1,0:03:57.21,0:04:02.50,Author,,0,0,0,,{}Які докази будуть визнані\Nдопустимими й чию вину\Nдоведуть, має визначити суд.
Dialogue: 1,0:04:02.50,0:04:06.94,Author,,0,0,0,,{}Окремих перевірених відповідей\Nусіх названих фігурантів у\Nзібраних матеріалах немає.
Dialogue: 1,0:04:06.94,0:04:09.26,Author,,0,0,0,,{}Презумпція невинуватості\Nпоширюється на кожного.
Dialogue: 1,0:04:09.26,0:04:12.00,Author,,0,0,0,,{}Версія слідства — ще не вирок.
